)
mapfile -t ascii_lines <<< "${ascii}"
mapfile -t info_lines <<< "${info}"

max_lines=${#ascii_lines[@]}
if [ ${#info_lines[@]} -gt ${max_lines} ]; then
    max_lines=${#info_lines[@]}
fi

max_width=0
for line in "${ascii_lines[@]}"; do
    clean_line=$(printf "%b" "$line" | sed 's/\x1b\[[0-9;]*m//g')
    len=${#clean_line}
    if (( len > max_width )); then
        max_width=$len
    fi
done

sil=$(( max_width + 4 ))

for ((i=0; i<max_lines; i++)); do
    printf "%b" "${ascii_lines[i]}"
    printf "\033[${sil}G%b\n" "${info_lines[i]}"
done
