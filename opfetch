${main}Kernel${NC}: $(uname -r)
${main}Uptime${NC}: $(uptime -p | sed 's/up //')
${main}Shell${NC}: ${SHELL##*/}
${main}CPU${NC}: $(awk -F': ' '/model name/ {print $2; exit}' /proc/cpuinfo)
${main}Memory${NC}: $(free | awk '/Mem:/ {p=($3/$2)*100; c=(p<60?"\033[92m":(p<85?"\033[93m":"\033[91m")); printf "%.1fGiB / %.1fGiB (%s%.0f%%\033[0m)", $3/1024/1024, $2/1024/1024, c, p}')

